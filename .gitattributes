* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary

# Scientific projects and archived evidence retain exact bytes for SHA256 provenance.
/projects/** -text whitespace=cr-at-eol,-blank-at-eof
/docs/archive/** -text whitespace=cr-at-eol,-blank-at-eof
/projects/**/*.svg -text whitespace=-blank-at-eol linguist-generated=true
/projects/**/*.sdf -whitespace linguist-generated=true
/projects/**/*.pdb -text -whitespace linguist-generated=true
/projects/**/*.npz binary linguist-generated=true
/projects/**/TASK.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

# New calculation evidence keeps its recorded byte hashes across Git platforms.
/data_omnibus/recompute/** -text whitespace=cr-at-eol,-blank-at-eof
/data_omnibus/recompute/**/*.npz binary linguist-generated=true
/docs/omnibus/TASK.md -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
